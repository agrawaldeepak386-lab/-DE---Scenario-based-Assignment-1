{
  "datasets": [
    {
      "name": "claims_fact",
      "displayName": "claims_fact",
      "queryLines": [
        "SELECT\n",
        "  f.*,\n",
        "  p.plan_code,\n",
        "  h.city_tier,\n",
        "  h.hospital_id,\n",
        "  h.hospital_name,\n",
        "  d.month_start,\n",
        "  to_date(CAST(f.admission_date_key AS STRING), 'yyyyMMdd') AS admission_date\n",
        "FROM\n",
        "  claims.analytics.fact_claims f\n",
        "    JOIN claims.analytics.dim_plan p\n",
        "      ON f.plan_sk = p.plan_sk\n",
        "    JOIN claims.analytics.dim_hospital h\n",
        "      ON f.hospital_sk = h.hospital_sk\n",
        "    JOIN claims.analytics.dim_date d\n",
        "      ON f.admission_date_key = d.date_key"
      ],
      "columns": [
        {
          "displayName": "rejection_rate",
          "description": "Rejected claims divided by decided claims (approved + rejected + settled), rounded to 4 dp.",
          "expression": "ROUND(SUM(CASE WHEN `status` = 'rejected' THEN 1 ELSE 0 END) / SUM(CASE WHEN `status` IN ('approved', 'rejected', 'settled') THEN 1 ELSE 0 END), 4)"
        },
        {
          "displayName": "hospital_label",
          "description": "Hospital id and name as a single display label.",
          "expression": "CONCAT(CAST(`hospital_id` AS STRING), ' - ', `hospital_name`)"
        },
        {
          "displayName": "avg_turnaround_days",
          "description": "Average turnaround days for settled claims, rounded to 2 dp.",
          "expression": "ROUND(AVG(`turnaround_days`), 2)"
        }
      ]
    }
  ],
